<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/pm25_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/pm10_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/no2_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/o3_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/so2_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <com.groupone.assignment.ui.aqi.PollutantCard
            android:id="@+id/co_card"
            style="@style/Widget.AirGreen.PollutantCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</merge>
