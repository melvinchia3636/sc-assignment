<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/city_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/dm_sans_medium"
                android:maxLines="1"
                android:text="@string/city_name"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/updated_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <com.groupone.assignment.ui.aqi.sections.AqiHeroSection
                android:id="@+id/aqi_hero"
                style="@style/Widget.AirGreen.AqiHeroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <com.groupone.assignment.ui.aqi.sections.GuidanceSection
                android:id="@+id/guidance_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/retry"
                        android:textColor="@color/green_700"
                        app:rippleColor="@color/ripple_green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.groupone.assignment.ui.common.SectionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:sectionTitle="@string/pollutants_label">
                <com.groupone.assignment.ui.aqi.sections.SubIndicesSection
                    android:id="@+id/sub_indices_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.groupone.assignment.ui.common.SectionView>

            <com.groupone.assignment.ui.common.SectionView
                android:id="@+id/weather_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:sectionTitle="@string/weather_label">
                <com.groupone.assignment.ui.aqi.sections.WeatherSection
                    android:id="@+id/weather_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.groupone.assignment.ui.common.SectionView>

            <com.groupone.assignment.ui.common.SectionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:sectionTitle="@string/trend_label">
                <com.groupone.assignment.ui.aqi.sections.TrendSection
                    android:id="@+id/trend_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.groupone.assignment.ui.common.SectionView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>