<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AirGreen.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="colorSecondary">@color/green_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_100</item>
        <item name="colorOnSecondaryContainer">@color/green_700</item>
        <item name="colorPrimaryContainer">@color/green_50</item>
        <item name="colorOnPrimaryContainer">@color/green_700</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/dialog_surface</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorControlNormal">@color/muted</item>
        <item name="colorControlActivated">@color/green_700</item>
        <item name="colorControlHighlight">@color/ripple_green</item>
        <item name="colorAccent">@color/green_700</item>
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/dialog_surface</item>
        <item name="colorSurfaceContainerLow">@color/dialog_surface</item>
        <item name="colorSurfaceContainer">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHighest">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Theme.AirGreen" parent="Theme.AirGreen.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ThemeOverlay.AirGreen.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@color/dialog_surface</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorSurfaceContainer">@color/dialog_surface</item>
        <item name="colorSurfaceContainerLow">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHighest">@color/dialog_surface</item>
        <item name="colorSurfaceVariant">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorSecondary">@color/green_700</item>
        <item name="colorOutlineVariant">@color/line</item>
    </style>

    <style name="Widget.AirGreen.AqiHeroCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/air_good</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.AirGreen.PollutantCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
