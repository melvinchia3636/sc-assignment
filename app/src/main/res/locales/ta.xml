    <string name="aqi_unknown">தெரியவில்லை</string>
    <string name="aqi_unknown_advice">காற்றின் தர தரவு இப்போது கிடைக்கவில்லை.</string>
    <string name="aqi_good">நல்லது</string>
    <string name="aqi_good_advice">காற்றின் தரம் திருப்திகரமாக உள்ளது. வெளியில் இருக்க நல்ல நாள்.</string>
    <string name="aqi_moderate">மிதமானது</string>
    <string name="aqi_moderate_advice">ஏற்றுக்கொள்ளக்கூடிய காற்றின் தரம். மிகவும் உணர்திறன் உள்ளவர்கள் நீண்ட உழைப்பைக் குறைக்கலாம்.</string>
    <string name="aqi_sensitive">உணர்திறன் குழுக்களுக்கு ஆபத்தானது</string>
    <string name="aqi_sensitive_advice">உணர்திறன் குழுக்கள் பாதிப்பை உணரலாம். நீண்ட வெளிப்புற செயல்பாடுகளைக் குறைக்கவும்.</string>
    <string name="aqi_unhealthy">ஆபத்தானது</string>
    <string name="aqi_unhealthy_advice">அனைவரும் பாதிப்பை உணரலாம். வெளிப்புற உழைப்பைக் குறைக்கவும்.</string>
    <string name="aqi_very_unhealthy">மிகவும் ஆபத்தானது</string>
    <string name="aqi_very_unhealthy_advice">சுகாதார எச்சரிக்கை. முடிந்தவரை வெளிப்புற செயல்பாடுகளைத் தவிர்க்கவும்.</string>
    <string name="aqi_hazardous">அபாயகரமானது</string>
    <string name="aqi_hazardous_advice">அவசர நிலை. ஜன்னல்களை மூடி உள்ளேயே இருக்கவும்.</string>

    <string name="error_offline">நீங்கள் ஆஃப்லைனில் உள்ளீர்கள். இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="error_no_data">இந்த இருப்பிடத்திற்கு தரவு இல்லை.</string>
    <string name="error_too_many">அதிக கோரிக்கைகள் உள்ளன. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="error_unavailable">சேவை தற்காலிகமாக கிடைக்கவில்லை. பின்னர் முயற்சிக்கவும்.</string>
    <string name="error_unexpected">சேவையிலிருந்து எதிர்பாராத பதில் (HTTP %1$d).</string>
    <string name="error_no_station">அருகில் எந்த கண்காணிப்பு நிலையமும் தரவை அனுப்பவில்லை.</string>
    <string name="error_station_list">நிலையப் பட்டியலைப் படிக்க முடியவில்லை.</string>
    <string name="error_station_data">நிலைய தரவைப் படிக்க முடியவில்லை.</string>
    <string name="error_station_token">நிலைய டோக்கனைப் பெற முடியவில்லை.</string>
    <string name="error_airnet_key">காற்றின் தர விசையைப் பெற முடியவில்லை.</string>
    <string name="error_request_prepare">கோரிக்கையைத் தயார் செய்ய முடியவில்லை.</string>
