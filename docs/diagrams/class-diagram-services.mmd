---
config:
  theme: default
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB

    class AirQualityService {
        -AqiApiClient client
        -LocalStore store
        +nearest(district: District) StationReading
        +byIdx(idx: String) StationReading
        +stations(district: District) List~StationSummary~
        +getCachedReading() Optional~StationReading~
        +getCachedStations() List~StationSummary~
    }

    class AqiApiClient {
        -OkHttpClient client
        -AqiJsonParser parser
        -HttpUrl baseUrl
        +nearestStation(latitude: double, longitude: double) StationReading
        +station(idx: String) StationReading
        +stations(south: double, west: double, north: double, east: double) List~StationSummary~
    }

    class AqiJsonParser {
        +parseStation(body: String) StationReading
        +parseStations(body: String) List~StationSummary~
        +errorMessage(body: String) String
    }

    class ApiException {
        <<exception>>
        -int statusCode
        +getStatusCode() int
        +isServiceFailure() boolean
        +messageFor(statusCode: int) String$
    }

    class LocalStore {
        -Path directory
        -Gson gson
        +loadReading() Optional~StationReading~
        +saveReading(reading: StationReading) void
        +loadReports() List~CitizenReport~
        +saveReports(reports: List~CitizenReport~) void
        +loadStations() List~StationSummary~
        +saveStations(stations: List~StationSummary~) void
        +loadSettings() Properties
        +saveSettings(settings: Properties) void
    }

    class SettingsStore {
        -LocalStore store
        -Properties properties
        +getDistrict() District
        +setDistrict(district: District) void
        +onDistrictChange(listener: Consumer~District~) void
        +getAudienceStrategy() AdviceStrategy
        +setAudienceStrategy(strategy: AdviceStrategy) void
        +getThreshold() AlertThreshold
        +setThreshold(threshold: AlertThreshold) void
    }

    class ReportService {
        -LocalStore store
        +add(district: District, category: String, note: String) CitizenReport
        +getAll() List~CitizenReport~
    }

    class ParksService {
        -List~Park~ parks
        +nearest(district: District) List~NearbyPark~
    }

    class Park {
        <<dataType>>
        +String name
        +District district
        +double latitude
        +double longitude
        +String facilities
    }

    class NearbyPark {
        <<dataType>>
        +Park park
        +double distanceKm
    }

    AirQualityService "1" --> "1" AqiApiClient : uses
    AirQualityService "1" --> "1" LocalStore : caches
    AqiApiClient "1" *-- "1" AqiJsonParser : parser
    AqiApiClient ..> ApiException : throws
    SettingsStore "1" --> "1" LocalStore : persists
    ReportService "1" --> "1" LocalStore : persists
    ParksService "1" o-- "0..*" Park : loads
    ParksService ..> NearbyPark : returns
    NearbyPark "1" --> "1" Park : ranks
